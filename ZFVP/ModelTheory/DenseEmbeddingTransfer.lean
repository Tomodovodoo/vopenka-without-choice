import ZFVP.SetTheory.DenseEmbedding
import ZFVP.ModelTheory.ForcingRealizationGeneration
import ZFVP.ModelTheory.ForcingModelChecks
import ZFVP.ModelTheory.ForcingModelGeneric

/-! A dense embedding `e : P → P'` transports generics: the filter generated by the image of a
generic is generic, the original generic is recovered from it, and the two extensions are
isomorphic membership structures over the ground model. -/

namespace ZFVP

open LO LO.FirstOrder LO.FirstOrder.SetTheory

variable {V : Type*} [SetStructure V] [Nonempty V] [V↓[ℒₛₑₜ] ⊧* 𝗭𝗙]

/-- The filter on `P'` generated by the image of `G`. -/
def denseImageFilter (P' R' e : V) (G : Set V) : Set V :=
  {p' | p' ∈ P' ∧ ∃ p ∈ G, ⟨e ‘ p, p'⟩ₖ ∈ R'}

theorem denseImageFilter_generic {P R P' R' e : V} {G : Set V} (hR : IsForcingPreorder P R)
    (hR' : IsForcingPreorder P' R') (he : IsDenseEmbedding P R P' R' e)
    (hG : IsExternalForcingGeneric P R G) :
    IsExternalForcingGeneric P' R' (denseImageFilter P' R' e G) := by
  refine ⟨⟨fun p' hp' ↦ hp'.1, ?_, ?_, ?_⟩, ?_⟩
  · obtain ⟨p, hp⟩ := hG.1.2.1
    have hpP := hG.1.1 p hp
    exact ⟨e ‘ p, he.value_mem hpP, p, hp, hR'.2.1 _ (he.value_mem hpP)⟩
  · rintro p' ⟨hp', p, hp, hpp'⟩ q' hq' hpq'
    exact ⟨hq', p, hp, hR'.2.2 _ (he.value_mem (hG.1.1 p hp)) p' hp' q' hq' hpp' hpq'⟩
  · rintro p' ⟨hp', p, hp, hpp'⟩ q' ⟨hq', q, hq, hqq'⟩
    obtain ⟨r, hr, hrp, hrq⟩ := hG.1.2.2.2 p hp q hq
    have hrP := hG.1.1 r hr
    have hpP := hG.1.1 p hp
    have hqP := hG.1.1 q hq
    refine ⟨e ‘ r, ⟨he.value_mem hrP, r, hr, hR'.2.1 _ (he.value_mem hrP)⟩, ?_, ?_⟩
    · exact hR'.2.2 _ (he.value_mem hrP) _ (he.value_mem hpP) p' hp' (he.2.1 p hpP r hrP hrp) hpp'
    · exact hR'.2.2 _ (he.value_mem hrP) _ (he.value_mem hqP) q' hq' (he.2.1 q hqP r hrP hrq) hqq'
  · intro D' hD'
    have hD : ForcingDense P R {p ∈ P ; ∃ d ∈ D', ⟨e ‘ p, d⟩ₖ ∈ R'} := by
      refine ⟨sep_subset, fun p hp ↦ ?_⟩
      obtain ⟨d, hd, hdp⟩ := hD'.2 _ (he.value_mem hp)
      obtain ⟨r, hr, hrp, hrd⟩ := he.exists_below hR hR' hp (hD'.1 d hd) hdp
      exact ⟨r, mem_sep_iff.mpr ⟨hr, d, hd, hrd⟩, hrp⟩
    obtain ⟨r, hr, hrD⟩ := hG.2 _ hD
    obtain ⟨_, d, hd, hrd⟩ := mem_sep_iff.mp hrD
    exact ⟨d, ⟨hD'.1 d hd, r, hr, hrd⟩, hd⟩

/-- The original generic is recovered from the generated filter. -/
theorem mem_denseImageFilter_iff {P R P' R' e : V} {G : Set V} (hR : IsForcingPreorder P R)
    (hR' : IsForcingPreorder P' R') (he : IsDenseEmbedding P R P' R' e)
    (hG : IsExternalForcingGeneric P R G) {p : V} (hp : p ∈ P) :
    e ‘ p ∈ denseImageFilter P' R' e G ↔ p ∈ G := by
  constructor
  · rintro ⟨_, q, hq, hqp⟩
    have hqP := hG.1.1 q hq
    have hD : ForcingDense P R {r ∈ P ; ⟨r, p⟩ₖ ∈ R ∨ ¬ ForcingCompatible P R r p} := by
      refine ⟨sep_subset, fun s hs ↦ ?_⟩
      by_cases hc : ForcingCompatible P R s p
      · obtain ⟨r, hr, hrs, hrp⟩ := hc
        exact ⟨r, mem_sep_iff.mpr ⟨hr, Or.inl hrp⟩, hrs⟩
      · exact ⟨s, mem_sep_iff.mpr ⟨hs, Or.inr hc⟩, hR.2.1 s hs⟩
    obtain ⟨r, hr, hrD⟩ := hG.2 _ hD
    obtain ⟨hrP, hcase⟩ := mem_sep_iff.mp hrD
    rcases hcase with hrp | hinc
    · exact hG.1.2.2.1 r hr p hp hrp
    · exfalso
      obtain ⟨t, ht, htr, htq⟩ := hG.1.2.2.2 r hr q hq
      have htP := hG.1.1 t ht
      apply hinc
      refine he.compatible_of_value hrP hp ⟨e ‘ t, he.value_mem htP, he.2.1 r hrP t htP htr, ?_⟩
      exact hR'.2.2 _ (he.value_mem htP) _ (he.value_mem hqP) _ (he.value_mem hp)
        (he.2.1 q hqP t htP htq) hqp
  · intro hpG
    exact ⟨he.value_mem hp, p, hpG, hR'.2.1 _ (he.value_mem hp)⟩

namespace ForcingContext

variable (A : ForcingContext V) {P' R' one' e : V} (hR' : IsForcingPreorder P' R')
  (htop' : IsForcingTop P' R' one') (he : IsDenseEmbedding A.P A.R P' R' e)

/-- The extension by the target of a dense embedding, with the transported generic. -/
noncomputable def denseImage : ForcingContext V where
  P := P'
  R := R'
  one := one'
  G := denseImageFilter P' R' e A.G
  order := hR'
  top := htop'
  generic := denseImageFilter_generic A.order hR' he A.generic

theorem denseImage_G : (A.denseImage hR' htop' he).G = denseImageFilter P' R' e A.G := rfl

theorem denseImage_check_value_mem_iff (p : V) (hp : p ∈ A.P) :
    ((A.denseImage hR' htop' he).check e) ‘ ((A.denseImage hR' htop' he).check p) ∈
      (A.denseImage hR' htop' he).genericSet ↔ p ∈ A.G := by
  haveI : IsFunction e := IsFunction.of_mem he.1
  rw [(A.denseImage hR' htop' he).check_value (by rw [domain_eq_of_mem_function he.1]; exact hp),
    (A.denseImage hR' htop' he).check_mem_genericSet_iff]
  exact mem_denseImageFilter_iff A.order hR' he A.generic hp

/-- The original extension realized inside the target extension. -/
noncomputable def denseImageRealization : ForcingRealization A (A.denseImage hR' htop' he).Model where
  ground := (A.denseImage hR' htop' he).checkEmbedding
  genericSet := {x ∈ (A.denseImage hR' htop' he).check A.P ;
    ((A.denseImage hR' htop' he).check e) ‘ x ∈ (A.denseImage hR' htop' he).genericSet}
  generic_subset := fun x hx ↦ (mem_sep_iff.mp hx).1
  generic_mem := fun p ↦ by
    change (A.denseImage hR' htop' he).check p ∈ _ ↔ p ∈ A.G
    rw [mem_sep_iff, (A.denseImage hR' htop' he).check_mem_iff]
    constructor
    · rintro ⟨hp, hx⟩
      exact (A.denseImage_check_value_mem_iff hR' htop' he p hp).mp hx
    · intro hp
      exact ⟨A.generic.1.1 p hp,
        (A.denseImage_check_value_mem_iff hR' htop' he p (A.generic.1.1 p hp)).mpr hp⟩

/-- The transported generic recovered inside the original extension. -/
noncomputable def denseRecoveredGeneric : A.Model :=
  {y ∈ A.check P' ; ∃ x ∈ A.genericSet, ⟨(A.check e) ‘ x, y⟩ₖ ∈ A.check R'}

include he in
theorem check_mem_denseRecoveredGeneric_iff (p' : V) :
    A.check p' ∈ A.denseRecoveredGeneric (e := e) (P' := P') (R' := R') ↔
      p' ∈ denseImageFilter P' R' e A.G := by
  haveI : IsFunction e := IsFunction.of_mem he.1
  unfold denseRecoveredGeneric
  rw [mem_sep_iff, A.check_mem_iff]
  constructor
  · rintro ⟨hp', x, hx, hxy⟩
    obtain ⟨p, hp, rfl⟩ := (A.mem_genericSet_iff x).mp hx
    rw [A.check_value (by rw [domain_eq_of_mem_function he.1]; exact A.generic.1.1 p hp),
      ← A.check_kpair, A.check_mem_iff] at hxy
    exact ⟨hp', p, hp, hxy⟩
  · rintro ⟨hp', p, hp, hpp'⟩
    refine ⟨hp', A.check p, (A.mem_genericSet_iff _).mpr ⟨p, hp, rfl⟩, ?_⟩
    rw [A.check_value (by rw [domain_eq_of_mem_function he.1]; exact A.generic.1.1 p hp),
      ← A.check_kpair, A.check_mem_iff]
    exact hpp'

/-- The target extension realized inside the original extension. -/
noncomputable def denseRecoveredRealization :
    ForcingRealization (A.denseImage hR' htop' he) A.Model where
  ground := A.checkEmbedding
  genericSet := A.denseRecoveredGeneric (e := e) (P' := P') (R' := R')
  generic_subset := fun x hx ↦ (mem_sep_iff.mp hx).1
  generic_mem := A.check_mem_denseRecoveredGeneric_iff he

theorem denseImageRealization_value_recovered :
    (A.denseImageRealization hR' htop' he).value (A.denseRecoveredGeneric (e := e) (P' := P') (R' := R')) =
      (A.denseImage hR' htop' he).genericSet := by
  let B := A.denseImage hR' htop' he
  let L := A.denseImageRealization hR' htop' he
  apply mem_ext
  intro z
  constructor
  · intro hz
    obtain ⟨x, hx, rfl⟩ := L.value_endExtension _ hz
    have hxP : x ∈ A.check P' := (mem_sep_iff.mp hx).1
    obtain ⟨p', _, rfl⟩ := (A.mem_check_iff P' x).mp hxP
    have hp' : p' ∈ denseImageFilter P' R' e A.G := (A.check_mem_denseRecoveredGeneric_iff he p').mp hx
    rw [L.value_check]
    exact (B.check_mem_genericSet_iff p').mpr hp'
  · intro hz
    obtain ⟨p', hp', rfl⟩ := (B.mem_genericSet_iff z).mp hz
    have hx : A.check p' ∈ A.denseRecoveredGeneric (e := e) (P' := P') (R' := R') :=
      (A.check_mem_denseRecoveredGeneric_iff he p').mpr hp'
    have := (L.value_mem_iff _ _).mpr hx
    rwa [L.value_check] at this

theorem denseRecoveredRealization_value_image :
    (A.denseRecoveredRealization hR' htop' he).value (A.denseImageRealization hR' htop' he).genericSet =
      A.genericSet := by
  let B := A.denseImage hR' htop' he
  let L := A.denseRecoveredRealization hR' htop' he
  apply mem_ext
  intro z
  constructor
  · intro hz
    obtain ⟨x, hx, rfl⟩ := L.value_endExtension _ hz
    have hxP : x ∈ B.check A.P := (A.denseImageRealization hR' htop' he).generic_subset x hx
    obtain ⟨p, _, rfl⟩ := (B.mem_check_iff A.P x).mp hxP
    have hp : p ∈ A.G := ((A.denseImageRealization hR' htop' he).generic_mem p).mp hx
    rw [L.value_check]
    show A.check p ∈ A.genericSet
    exact (A.check_mem_genericSet_iff p).mpr hp
  · intro hz
    obtain ⟨p, hp, rfl⟩ := (A.mem_genericSet_iff z).mp hz
    have hx : B.check p ∈ (A.denseImageRealization hR' htop' he).genericSet :=
      ((A.denseImageRealization hR' htop' he).generic_mem p).mpr hp
    have := (L.value_mem_iff _ _).mpr hx
    rw [L.value_check] at this
    change A.check p ∈ _ at this
    exact this

theorem denseImageRealization_surjective :
    Function.Surjective (A.denseImageRealization hR' htop' he).value :=
  ForcingRealization.value_surjective_of_generators (A.denseImage hR' htop' he)
    (A.denseImageRealization hR' htop' he)
    (fun x ↦ ⟨A.check x, (A.denseImageRealization hR' htop' he).value_check x⟩)
    ⟨_, A.denseImageRealization_value_recovered hR' htop' he⟩

theorem denseRecoveredRealization_surjective :
    Function.Surjective (A.denseRecoveredRealization hR' htop' he).value :=
  ForcingRealization.value_surjective_of_generators A
    (A.denseRecoveredRealization hR' htop' he)
    (fun x ↦ ⟨(A.denseImage hR' htop' he).check x, (A.denseRecoveredRealization hR' htop' he).value_check x⟩)
    ⟨_, A.denseRecoveredRealization_value_image hR' htop' he⟩

/-- Extensions along a dense embedding are isomorphic membership structures. -/
noncomputable def denseEquiv : A.Model ≃ (A.denseImage hR' htop' he).Model :=
  Equiv.ofBijective (A.denseImageRealization hR' htop' he).value
    ⟨(A.denseImageRealization hR' htop' he).value_injective, A.denseImageRealization_surjective hR' htop' he⟩

theorem denseEquiv_mem_iff (x y : A.Model) :
    A.denseEquiv hR' htop' he x ∈ A.denseEquiv hR' htop' he y ↔ x ∈ y :=
  (A.denseImageRealization hR' htop' he).value_mem_iff x y

theorem denseEquiv_check (x : V) :
    A.denseEquiv hR' htop' he (A.check x) = (A.denseImage hR' htop' he).check x :=
  (A.denseImageRealization hR' htop' he).value_check x

end ForcingContext

end ZFVP
